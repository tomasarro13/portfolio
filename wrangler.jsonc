{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name you choose in the Cloudflare dashboard.
  "name": "tomas-ariza-portfolio",
  "compatibility_date": "2026-09-11",
  // Static site only: no Worker script, Cloudflare serves the files in ./dist.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
