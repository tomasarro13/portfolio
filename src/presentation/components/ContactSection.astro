---
import type { ProfileDto } from '@application/dto/PortfolioDtos';
import ExternalLink from './ExternalLink.astro';
import Section from './Section.astro';

interface Props {
  profile: ProfileDto;
}

const { profile } = Astro.props;
---

<Section id="contact" title="Contact">
  <div class="contact prose">
    <p>
      I am looking for an internship in AI, automation or software engineering, starting in January
      2027, where I can keep growing alongside an experienced team. Email is the best way to reach
      me.
    </p>
    <a class="contact__email" href={profile.emailHref}>
      {profile.email}
    </a>
    {profile.links.length > 0 && (
      <ul class="contact__links">
        {profile.links.map((link) => (
          <li>
            <ExternalLink href={link.href}>{link.label}</ExternalLink>
          </li>
        ))}
      </ul>
    )}
    <figure class="contact__globe">
      <div
        class="contact__globe-canvas"
        data-hypermotion="globe"
        data-props={JSON.stringify({
          markers: [{ location: [4.711, -74.072], size: 0.08, id: 'bogota' }],
          autoRotate: true,
          pointCount: 9000,
          landPointColor: '#93a7ff',
          fresnelConfig: { color: '#15202b', rimColor: '#4f6bed', rimPower: 6, rimIntensity: 1.2 },
          atmosphereConfig: {
            color: '#4f6bed',
            scale: 1.1,
            power: 12,
            coefficient: 0.9,
            intensity: 0.8,
          },
          scale: 1.05,
          focusOn: [4.6, -74.1],
        })}
      ></div>
      <figcaption class="muted">Based in Bogotá, Colombia · open to remote work</figcaption>
    </figure>
  </div>
</Section>

<style>
  .contact {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .contact__email {
    font-size: clamp(var(--text-md), 1rem + 2vw, var(--text-xl));
    font-weight: 700;
    font-stretch: 110%;
    overflow-wrap: anywhere;
  }

  .contact__globe {
    display: grid;
    gap: 0.75rem;
    width: min(100%, 22rem);
    font-size: var(--text-sm);
  }

  .contact__globe-canvas {
    position: relative;
    aspect-ratio: 1;
  }

  /* Without the globe (reduced motion, or it failed to load), the caption is enough. */
  .contact__globe-canvas:is([data-hypermotion-state='failed'], [data-hypermotion-state='skipped']) {
    display: none;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-weight: 600;
  }
</style>
