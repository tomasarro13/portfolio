---
import type { CredentialItem } from '../view-models/CredentialItem';
import ExternalLink from './ExternalLink.astro';

interface Props {
  items: readonly CredentialItem[];
}

const { items } = Astro.props;
---

<ul class="credentials">
  {items.map((item) => (
    <li class="credential">
      <div>
        <h3 class="credential__title">{item.title}</h3>
        <p class="muted">{item.source}</p>
        {item.link && (
          <p class="credential__link">
            <ExternalLink href={item.link.href}>{item.link.label}</ExternalLink>
          </p>
        )}
      </div>
      <p class="credential__date muted">
        {item.datetime ? <time datetime={item.datetime}>{item.date}</time> : item.date}
      </p>
    </li>
  ))}
</ul>

<style>
  .credentials {
    display: grid;
  }

  .credential {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
    transition:
      border-color var(--speed) var(--ease),
      padding-left var(--speed) var(--ease);
  }

  .credential:hover {
    padding-left: 0.5rem;
    border-bottom-color: var(--cobalt);
  }

  .credential:first-child {
    padding-top: 0;
  }

  .credential__title {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.35;
  }

  .credential__date {
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .credential__link {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
  }
</style>
